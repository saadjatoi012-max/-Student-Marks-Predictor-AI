import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split

# 1. Sample Data banaya - Hours Studied vs Marks
data = {
    'Hours_Studied': [2, 3, 4, 5, 6, 7, 8, 9, 10],
    'Marks': [45, 50, 55, 60, 65, 70, 75, 80, 85]
}
df = pd.DataFrame(data)

# 2. AI Model Train karna
X = df[['Hours_Studied']]
y = df['Marks']
model = LinearRegression()
model.fit(X, y)

# 3. Prediction
hours = 7.5
predicted_marks = model.predict([[hours]])
print(f"Agar student {hours} ghante parhega to expected marks: {predicted_marks[0]:.2f}")

# 4. Graph
plt.scatter(X, y, color='blue')
plt.plot(X, model.predict(X), color='red')
plt.title('AI Model: Hours vs Marks')
plt.xlabel('Hours Studied')
plt.ylabel('Marks')
plt.show()